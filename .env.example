# Example environment variables for local development.
# Copy to `.env` for local use. Do not commit `.env`.

# Postgres connection URL (used by the Reef / Lore store)
LORELEI_POSTGRES_URL=postgres://lorelei:lorelei@localhost:5432/lorelei

# Qdrant URL (used by vector retrieval)
LORELEI_QDRANT_URL=http://localhost:6333

# Provider keys (examples; values are placeholders)
LORELEI_MOCK_API_KEY=replace-me

