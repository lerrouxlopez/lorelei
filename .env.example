# Example environment variables for local development.
# Copy to `.env` for local use. Do not commit `.env`.

# Postgres connection URL (used by the Reef / Lore store)
# - local:     postgres://lorelei:lorelei@localhost:5432/lorelei
# - compose:   postgres://lorelei:lorelei@postgres:5432/lorelei
DATABASE_URL=postgres://lorelei:lorelei@postgres:5432/lorelei

# Qdrant URL (gRPC; qdrant-client expects port 6334)
# - local:     http://localhost:6334
# - compose:   http://qdrant:6334
QDRANT_URL=http://qdrant:6334

# Provider keys (examples; values are placeholders)
LORELEI_MOCK_API_KEY=replace-me
