# Lorelei local development environment.

# Harbor (API) base URL
LORELEI_HARBOR_URL=http://127.0.0.1:8080

# Harbor loads config from this path
LORELEI_CONFIG=

# Multi-tenant identifiers for CLI requests
TENANT_ID=
AGENT_ID=

# Required runtime dependencies for Harbor
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lorelei
QDRANT_URL=http://127.0.0.1:6334

# Provider keys (example env vars referenced by lorelei.toml.example)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

