# Lorelei configuration example.
#
# Notes:
# - Prefer `source = "env"` for secrets. Lorelei redacts secrets in Debug/Display.
# - Keep this file out of logs and never commit real secrets.

[providers.openai]
kind = "openai-compatible"
base_url = "https://api.openai.com/v1"
model = "gpt-4.1-mini"
api_key = { source = "env", var = "OPENAI_API_KEY" }

[providers.anthropic]
kind = "anthropic"
model = "claude-3-7-sonnet-latest"
api_key = { source = "env", var = "ANTHROPIC_API_KEY" }

[providers.gemini]
kind = "gemini-native"
model = "gemini-2.5-pro"
api_key = { source = "env", var = "GEMINI_API_KEY" }

[providers.bedrock]
kind = "bedrock"
region = "us-east-1"
model_id = "anthropic.claude-3-sonnet-20240229-v1:0"
# Usually provided by IAM role / AWS SDK env vars; optional explicit config:
# access_key_id = { source = "env", var = "AWS_ACCESS_KEY_ID" }
# secret_access_key = { source = "env", var = "AWS_SECRET_ACCESS_KEY" }

[providers.local]
kind = "local"
endpoint = "http://127.0.0.1:11434"
model = "llama3.1"

[song]
provider = { name = "openai" }

